  "name": "Meezan bank template",
  "prepared_report": 0,
  "query": "SELECT\r\n    -- Clickable Entry ID link\r\n    je.name AS \"ENTRY ID:Link/Journal Entry:150\",\r\n    jea.iban AS \"ACCOUNT NUMBER:Data:200\",\r\n    jea.party_name AS \"BENE NAME:Data:150\",\r\n    jea.user_remark AS \"CUSTOMER REFERENCE N0:Data:150\",\r\n    jea.debit AS \"TRANS AMOUNT:Currency:120\",\r\n    jea.bank_code AS \"BANK CODE:Data:100\",\r\n    jea.bank_account AS \"BENEFICIARY ACCOUNT TITLE:Data:200\"\r\nFROM\r\n    `tabJournal Entry` je\r\nJOIN\r\n    `tabJournal Entry Account` jea ON je.name = jea.parent\r\nWHERE\r\n    je.docstatus < 2\r\n    AND jea.debit > 0\r\n    AND (%(entry_id)s IS NULL OR je.name IN %(entry_id)s)\r\n",
